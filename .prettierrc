{
  "tabWidth": 2,
  "printWidth": 100,
  "plugins": ["prettier-plugin-tailwindcss", "@ianvs/prettier-plugin-sort-imports"],
  "jsxBracketSameLine": true,
  "importOrder": [
    "^react$",
    "^react-router-dom$",
    "^@/hooks",
    "^@/components/(.*)$",
    "^@/ui/(.*)$",
    "<THIRD_PARTY_MODULES>",
    "^[./]"
  ]
}
